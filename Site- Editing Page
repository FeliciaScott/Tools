function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function render(){
 const q=document.getElementById('search').value.toLowerCase(), g=document.getElementById('groupFilter').value, d=document.getElementById('statusFilter').value;
 const filtered=pages.filter(p=>(!q||[p.name,p.purpose,p.content,p.buttons,p.parent,p.group].join(" ").toLowerCase().includes(q))&&(!g||p.group===g)&&(!d||p.decision===d));
 document.getElementById('rows').innerHTML=filtered.map(p=>`<tr><td><b>${esc(p.name)}</b><br><span class="pill">${esc(p.group)}</span></td><td>${esc(p.purpose)}</td><td>${esc(p.content)}</td><td>${esc(p.buttons)}<br><span class="small">Connect to: ${esc(p.next)}</span></td><td>${esc(p.parent)}</td><td><select aria-label="Editing decision for ${esc(p.name)}" data-title="${esc(p.name)}" class="decision"><option ${p.decision==="Keep"?"selected":""}>Keep</option><option ${p.decision==="Review"?"selected":""}>Review</option><option ${p.decision==="Merge"?"selected":""}>Merge</option><option ${p.decision==="Rename"?"selected":""}>Rename</option><option ${p.decision==="Move"?"selected":""}>Move</option><option ${p.decision==="Create"?"selected":""}>Create</option></select></td></tr>`).join("");
 document.getElementById('pageCount').textContent=pages.length;
 document.getElementById('coreCount').textContent=core.length;
 document.getElementById('linkCount').textContent=linkRows.length;
}
function renderGroups(){const sel=document.getElementById('groupFilter');[...new Set(pages.map(p=>p.group))].sort().forEach(g=>sel.add(new Option(g,g)))}
function renderCore(){document.getElementById('coreCards').innerHTML=core.map(c=>`<article class="card"><h3>${esc(c[0])}</h3><span class="pill">${esc(c[1])}</span><p>${esc(c[2])}</p><p><b>Button plan:</b> ${esc(c[3])}</p></article>`).join("")}
function renderLinks(){document.getElementById('links').innerHTML=linkRows.map(r=>`<tr>${r.map(v=>`<td>${esc(v)}</td>`).join("")}</tr>`).join("")}
document.getElementById('search').addEventListener('input',render);
document.getElementById('groupFilter').addEventListener('change',render);
document.getElementById('statusFilter').addEventListener('change',render);
document.getElementById('rows').addEventListener('change',e=>{if(e.target.matches('.decision')){const p=pages.find(x=>x.name===e.target.dataset.title);if(p)p.decision=e.target.value}});
function downloadCSV(){const header=["Page title","Group","Parent","Editing decision","Purpose","Information to include","Recommended buttons","Connect to"];const rows=pages.map(p=>[p.name,p.group,p.parent,p.decision,p.purpose,p.content,p.buttons,p.next]);const csv=[header,...rows].map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\r\n");const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='pathkeeper-page-content-link-map.csv';a.click();URL.revokeObjectURL(a.href)}
renderGroups();renderCore();renderLinks();render();
</script>
